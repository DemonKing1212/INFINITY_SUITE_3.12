<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/themes_title">
    
    <!-- Themes -->
    <Preference
        android:key="custom_system_theme"
        android:title="@string/custom_system_theme_title"
        android:summary="@string/custom_system_theme_summary">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.android.axion.axthemestore"
            android:targetClass="com.android.axion.axthemestore.MainActivity" />
    </Preference>

    <!-- Settings Icons-->
    <Preference
        android:key="settings_icon"
        android:title="@string/settings_icon_title"
        android:summary="@string/settings_icon_summary"
        android:fragment="com.infinity.suite.fragments.SettingIcons" />

    <com.infinity.support.preferences.SecureSettingListPreference
        android:key="power_menu_compose_style"
        android:title="@string/power_menu_compose_style_title"
        android:entries="@array/power_menu_compose_style_entries"
        android:entryValues="@array/power_menu_compose_style_values"
        android:defaultValue="1"
        android:summary="%s" />

        <!-- System Animation styles  -->
        <com.infinity.support.preferences.SystemSettingListPreference
            android:key="system_animation_style"
            android:title="@string/system_animation_style_title"
            android:dialogTitle="@string/system_animation_style_title"
            android:entries="@array/system_animation_styles_entries"
            android:entryValues="@array/system_animation_styles_values"
            android:defaultValue="0"
            android:summary="%s" />

    <!-- Wallpaper Settings -->
    <Preference
        android:key="wallpaper_settings"
        android:title="@string/wallpaper_settings_title"
        android:summary="@string/wallpaper_settings_summary"
        android:fragment="com.infinity.suite.fragments.Wallpaper" />

    <!-- Gradient Customization -->
    <Preference
        android:key="gradient_settings"
        android:title="@string/gradient_settings_title"
        android:summary="@string/gradient_settings_summary"
        android:fragment="com.infinity.suite.fragments.GradientSettings" />

        <!-- Boot animation -->
        <Preference
            android:key="boot_animation"
            android:title="@string/themes_boot_animation_title"
            android:summary="@string/themes_boot_animation_summary"
            android:fragment="com.infinity.suite.fragments.BootAnimation"
settings:controller="com.infinity.suite.fragments.BootAnimationController" />

        <!-- Charging animation -->
        <Preference
            android:key="charging_animation_settings"
            android:title="@string/charging_effects_title"
            android:summary="@string/charging_effects_summary"
            android:fragment="com.infinity.suite.fragments.ChargingAnimationSettings" />

    <!-- Font style -->
    <Preference
        android:key="android.theme.customization.fonts"
        android:title="@string/theme_customization_font_title"
        android:summary="@string/theme_customization_font_summary"
        android:fragment="com.infinity.suite.fragments.FontStyle"/>

    <!-- Emoji Style -->
    <com.infinity.support.preferences.SystemSettingListPreference
        android:key="emoji_style"
        android:title="@string/emoji_style_title"
        android:summary="%s"
        android:entries="@array/emoji_style_entries"
        android:entryValues="@array/emoji_style_values"
        android:defaultValue="android" />


    <!-- Navbar Style -->
    <Preference
        android:key="android.theme.customization.navbar"
        android:title="@string/theme_customization_navbar_title"
        android:summary="@string/theme_customization_navbar_summary"
        android:fragment="com.infinity.suite.fragments.NavbarStyles"/>

<com.infinity.suite.preferences.OverlaySwitchPreference
    android:key="com.android.settingslib.smileswitch"
    android:title="@string/smile_switch_title"
    android:summary="@string/smile_switch_summary"
    android:defaultValue="false" />

    <PreferenceCategory
        android:key="volume_category"
        android:title="@string/volume_category">

  <com.infinity.support.preferences.SystemSettingListPreference
            android:key="volume_dialog_type"
            android:title="@string/volume_dialog_type_title"
            android:summary="%s"
            android:entries="@array/volume_dialog_type_entries"
            android:entryValues="@array/volume_dialog_type_values"
            android:defaultValue="1" />

    <com.infinity.support.preferences.SystemSettingListPreference
            android:key="compose_volume_style"
            android:title="@string/compose_volume_style_title"
            android:summary="%s"
            android:entries="@array/compose_volume_style_entries"
            android:entryValues="@array/compose_volume_style_values"
            android:defaultValue="0" />

    <com.infinity.support.preferences.SystemSettingSwitchPreference
            android:key="show_volume_percentage"
            android:title="@string/show_volume_percentage_title"
            android:summary="@string/show_volume_percentage_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="themes_audio_category"
        android:title="@string/themes_audio_category">

        <!-- Lock sound -->
        <com.infinity.support.preferences.GlobalSettingListPreference
            android:key="lock_sound"
            android:title="@string/themes_lock_sound_title"
            android:entries="@array/themes_lock_unlock_sounds_entries"
            android:entryValues="@array/themes_lock_sounds_values"
            android:defaultValue="/product/media/audio/ui/Lock.ogg" />

        <!-- Unlock sound -->
        <com.infinity.support.preferences.GlobalSettingListPreference
            android:key="unlock_sound"
            android:title="@string/themes_unlock_sound_title"
            android:entries="@array/themes_lock_unlock_sounds_entries"
            android:entryValues="@array/themes_unlock_sounds_values"
            android:defaultValue="/product/media/audio/ui/Unlock.ogg" />
    </PreferenceCategory>

</PreferenceScreen>
